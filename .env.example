# =============================================================================
# VERA AI - Environment Variables & Model Configuration
# =============================================================================

# Primary Provider (Tier 1 & Tier 2 Auto-Rotating Keys)
# Get keys at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY1=your_gemini_api_key_primary
GEMINI_API_KEY2=your_gemini_api_key_secondary
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=6.0

# Tier 3 Backup Failover Provider (Mistral AI)
# Get key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=ministral-8b-latest
MISTRAL_TIMEOUT_SECONDS=8.0

# Batch Concurrency & Tick Timeout Budget
# Overall hard deadline for /v1/tick batch processing
TICK_TIMEOUT_SECONDS=25.0
